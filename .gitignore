# Sentaurus TCAD binary output files (large, auto-generated — do NOT commit)
*.tdr
*.log
*.out
*.err
*.plt_old
*.bak

# SWB auto-generated run folders (huge binary output, not needed in git)
[0-9]_*/
n[0-9]*/
p[0-9]*/

# Python virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.env

# OS files
.DS_Store
Thumbs.db

# NOTE: results/*.plt files ARE committed (simulation data for Python)
# NOTE: results/*.png and results/*.csv ARE committed (final output figures)
# Nothing in results/ is blocked — we want everything there on GitHub
